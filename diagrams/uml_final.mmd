classDiagram
    direction TB

    class Owner {
        +str name
        +str email
        +str owner_id
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet_by_id(pet_id: str) Optional~Pet~
        +get_all_tasks() List
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +str notes
        +List~Task~ tasks
        +str pet_id
        +add_task(task: Task) None
        +get_pending_tasks() List~Task~
        +get_summary() str
    }

    class Task {
        +str description
        +datetime due_datetime
        +str frequency
        +bool is_completed
        +str task_id
        +mark_complete() None
        +mark_pending() None
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(tasks) List
        +filter_tasks(completed, pet_name) List
        +get_schedule_for_date(target_date: date) List
        +get_today_schedule() List
        +get_all_pending() List
        +complete_task(pet: Pet, task: Task) Optional~Task~
        +find_conflicts() List~str~
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : schedules
    Scheduler --> Owner : queries and coordinates
